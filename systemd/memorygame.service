[Unit]
Description=GNMC Memory TalkTalk Kiosk
After=multi-user.target graphical.target

[Service]
Type=simple
User=arduino
Group=arduino
WorkingDirectory=/opt/memorygame
Environment=DISPLAY=:0
Environment=PYTHONUNBUFFERED=1
Environment=MEMORYGAME_CONFIG=/home/arduino/config.yaml
ExecStart=/usr/bin/python3 -m mpu.main
Restart=always
RestartSec=2
WatchdogSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
